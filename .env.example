# Copy to .env, edit, and never commit private settings.
WHISPER_PORT=7865
# Optional: bind one trusted LAN interface IP for access from another device.
# No login is provided; do not use 0.0.0.0 or expose the port to the internet.
# WHISPER_HOST=192.168.1.10
WHISPER_THREADS=2
WHISPER_MAX_UPLOAD_MB=200
WHISPER_MAX_DURATION_SECONDS=7200
WHISPER_MAX_OUTSTANDING=3
WHISPER_RETENTION_DAYS=7
WHISPER_DATA_DIR=$HOME/.local/share/whisper-local
WHISPER_MODEL_DIR=$HOME/.cache/whisper
# WHISPER_BATCH_ROOTS=$HOME/Music:$HOME/recordings
# WHISPER_PYTHON=/absolute/path/to/python
# WHISPER_CONDA_ENV=whisper-cpu
# Host microphone: generate a private token with `openssl rand -hex 24`.
# WHISPER_HOST_MIC_TOKEN=your-random-token
# WHISPER_CAPTURE_DEVICE=default

# Optional ASR confidence gate (1=on, 0=off)
WHISPER_FILTER_LOW_CONFIDENCE=1
# Optional Mandarin prompt; do not force this for every recording
# WHISPER_ZH_INITIAL_PROMPT=以下是普通话的句子。
